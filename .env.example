# Copia este archivo como .env y completa solo lo que vaya a usar tu entorno.
# Nunca guardes credenciales reales en Git.

# anthropic | codex | claude-cli | gemini
LLM_PROVIDER=anthropic

# Opcionales: si no se indican, cada adaptador usa su modelo por defecto.
LLM_MODELO_COMPOSITOR=
LLM_MODELO_AGENTE=

# Solo hace falta para npm run harvest -- --enrich o npm run descubrir.
GOOGLE_PLACES_API_KEY=

# Solo hace falta si LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# El SDK de Anthropic lee ANTHROPIC_API_KEY del entorno.
ANTHROPIC_API_KEY=

# Obligatorio para una campaña real: destino humano del handoff, en E.164.
# NUMERO_HUMANO=+51987654321

# ── Canal ──────────────────────────────────────────────────────────────
# Default: baileys (sesión de WhatsApp Web vinculada por QR).
#
# CANAL=cloud activa el adaptador de la API oficial de Meta. IMPORTANTE:
# ese canal solo puede CONTESTAR dentro de la ventana de 24h que abre cada
# mensaje del prospecto. No permite iniciar conversaciones con texto libre
# (requiere plantillas aprobadas, no implementado), así que campana exige
# --sin-tanda en ese modo. Ver src/wa/cloud-api.ts.
#
# CANAL=cloud

# Solo con CANAL=cloud (consola developers.facebook.com → WhatsApp):
# WHATSAPP_TOKEN=token-del-usuario-de-sistema
# WHATSAPP_PHONE_NUMBER_ID=id-del-numero
# WHATSAPP_APP_SECRET=secreto-para-verificar-la-firma-del-webhook
# WHATSAPP_VERIFY_TOKEN=token-propio-del-handshake
# PUERTO_WEBHOOK=3000

# Plantillas utility aprobadas en Meta, necesarias en modo nube para lo que es
# business-initiated. Cada una lleva UN hueco {{1}} en el body:
#   FOLLOWUP:      follow-ups fuera de ventana; {{1}} = el mensaje compuesto.
#   NOTIFICACION:  aviso de handoff a NUMERO_HUMANO; {{1}} = el resumen del lead.
# Sin FOLLOWUP configurada, campana rechaza correr tandas en modo nube.
# El idioma default es "es"; cámbialo con *_IDIOMA si aprobaste otra versión.
# WHATSAPP_PLANTILLA_FOLLOWUP=nombre_de_la_plantilla
# WHATSAPP_PLANTILLA_NOTIFICACION=nombre_de_la_plantilla
