# Copia este archivo como .env y completa solo lo que vaya a usar tu entorno.
# Nunca guardes credenciales reales en Git.

# anthropic | codex | claude-cli | gemini
LLM_PROVIDER=anthropic

# Opcionales: si no se indican, cada adaptador usa su modelo por defecto.
LLM_MODELO_COMPOSITOR=
LLM_MODELO_AGENTE=

# Solo hace falta para npm run harvest -- --enrich o npm run descubrir.
GOOGLE_PLACES_API_KEY=

# Solo hace falta si LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# El SDK de Anthropic lee ANTHROPIC_API_KEY del entorno.
ANTHROPIC_API_KEY=

# Obligatorio para una campaña real: destino humano del handoff, en E.164.
# NUMERO_HUMANO=+51987654321
